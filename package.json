{
  "name": "packzen",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "dev": "bun run version:generate:dev && astro dev",
    "build": "bun run validate:data && bun run version:generate && astro build && bun run sw:generate",
    "preview": "astro preview",
    "test": "node --import tsx --import ./tests/raw-import.mjs --test 'tests/*.test.ts'",
    "typecheck": "tsc --noEmit && astro check",
    "astro": "astro",
    "version:generate": "node scripts/generate-version.js",
    "version:generate:dev": "NODE_ENV=development node scripts/generate-version.js",
    "sw:generate": "node scripts/generate-sw.js",
    "validate:data": "node scripts/validate-built-in-items.js",
    "db:migrate": "wrangler d1 migrations apply packzen-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply packzen-db --remote",
    "db:studio": "drizzle-kit studio",
    "deploy": "wrangler d1 migrations apply packzen-db --remote && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/setup-git-hooks.js"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/solid-js": "^5.1.3",
    "@clerk/astro": "^2.17.15",
    "@tailwindcss/vite": "^4.3.3",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "astro": "^5.18.2",
    "drizzle-orm": "^0.45.3",
    "js-yaml": "^5.4.2",
    "papaparse": "^5.7.0",
    "solid-js": "^1.9.15",
    "svix": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@miniflare/d1": "^2.14.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/papaparse": "^5.5.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.142.0"
  }
}
