---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PricingTable } from '@clerk/astro/components';
---

<BaseLayout title="Pricing - PackZen" analytics>
  <div class="min-h-screen bg-gray-50">
    <header class="border-b border-gray-200 bg-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4">
        <a href="/" class="flex items-center gap-2 font-semibold text-gray-900">
          <img src="/icon-192.png" alt="" width="32" height="32" class="h-8 w-8 rounded-full" />
          PackZen
        </a>
        <a
          href="/trips"
          class="flex items-center text-sm font-medium text-blue-600 hover:underline"
        >
          My Trips →
        </a>
      </div>
    </header>

    <div class="mx-auto max-w-7xl px-4 py-12">
      <div class="mb-12 text-center">
        <h1 class="mb-4 text-4xl font-bold text-gray-900">Choose Your Plan</h1>
        <p class="text-lg text-gray-600">
          The free plan covers up to 3 trips, with no time limit. Upgrade anytime for more.
        </p>
      </div>

      <PricingTable newSubscriptionRedirectUrl="/trips" />
    </div>
  </div>
</BaseLayout>
