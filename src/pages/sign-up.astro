---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SignUp, Show } from '@clerk/astro/components';
import { DEV_FAKE_AUTH } from '../lib/dev-auth';
---

<BaseLayout title="Sign Up - PackZen" analytics>
  <div class="flex min-h-screen items-center justify-center bg-gray-50 px-4 py-12">
    <div class="w-full max-w-md">
      <div class="mb-8 text-center">
        <h1 class="mb-2 text-3xl font-bold text-gray-900">Get Started</h1>
        <p class="text-gray-600">Create your account to start packing smarter</p>
      </div>

      <div class="flex justify-center">
        <Show when="signed-out">
          <!--
            Clerk's <SignUp> renders its own loading + error states, fixing the
            empty-box problem. It natively reads the `redirect_url` query param
            for the post-sign-up redirect and preserves it on the sign-in link,
            so `fallbackRedirectUrl` only applies when `redirect_url` is absent.
          -->
          <SignUp signInUrl="/sign-in" fallbackRedirectUrl="/trips" />
          <p slot="fallback" class="text-gray-600">
            You're already signed in. Redirecting…
          </p>
        </Show>
      </div>

      {DEV_FAKE_AUTH && (
        <div class="mt-6 text-center">
          <a href="/dev/login" class="text-sm text-gray-500 underline hover:text-gray-700">
            → Dev login (fake auth)
          </a>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  import { isSignedIn, safeRedirectPath } from '../lib/clerk';

  // Already signed in: go where the visitor was headed, or home.
  isSignedIn()
    .then((signedIn) => {
      if (signedIn) {
        const target = new URLSearchParams(window.location.search).get('redirect_url');
        window.location.replace(safeRedirectPath(target));
      }
    })
    .catch((error) => console.error('Auth check failed:', error));
</script>
