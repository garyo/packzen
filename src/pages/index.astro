---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="PackZen - Travel Packing Made Easy" analytics>
  <!--
    The landing page renders immediately for everyone (good for SEO and for
    visitors where Clerk is slow/blocked — it fails open). Once Clerk loads,
    signed-in users are redirected to their trips.
  -->
  <script>
    import { isSignedIn } from '../lib/clerk';

    (async () => {
      try {
        // Use replace to avoid the back button returning to the landing page.
        if (await isSignedIn()) {
          window.location.replace('/trips');
        }
      } catch (error) {
        // Fail open — leave the landing page visible.
        console.error('Auth check failed:', error);
      }
    })();
  </script>
  <div class="min-h-screen bg-gradient-to-b from-blue-50 to-white">
    <!-- Hero: logo, pitch and sign-up fit on a small phone's first screen -->
    <section class="container mx-auto px-4 pt-8 pb-12 md:pt-16">
      <div class="mx-auto max-w-3xl text-center">
        <img
          src="/logo.webp"
          alt="PackZen"
          width="320"
          height="320"
          class="mx-auto mb-5 h-28 w-28 rounded-2xl md:mb-8 md:h-40 md:w-40"
        />
        <h1 class="mb-4 text-4xl font-bold text-gray-900 md:text-6xl">
          Pack Smarter,
          <br />
          Travel Better
        </h1>
        <p class="mb-6 text-lg text-gray-600 md:mb-8 md:text-xl">
          Packing lists that remember what you bring, sort it by bag, and print as a clean
          checklist.
        </p>

        <div class="flex flex-col justify-center gap-3 sm:flex-row sm:gap-4">
          <a
            href="/sign-up"
            class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-8 py-3 text-lg font-semibold text-white transition-colors hover:bg-blue-700"
          >
            Get Started Free
          </a>
          <a
            href="/sign-in"
            class="inline-flex items-center justify-center rounded-lg border-2 border-blue-600 bg-white px-8 py-3 text-lg font-semibold text-blue-600 transition-colors hover:bg-blue-50"
          >
            Sign In
          </a>
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section class="container mx-auto px-4 py-12">
      <div class="mx-auto grid max-w-4xl gap-6 md:grid-cols-2">
        <div class="rounded-lg bg-white p-6 shadow-md">
          <div class="mb-3 text-4xl">🖨️</div>
          <h2 class="mb-2 text-xl font-semibold text-gray-900">Print a clean checklist</h2>
          <p class="text-gray-600">
            Print your list grouped by bag, with containers and notes, and tick things off with a
            pen as you pack.
          </p>
        </div>

        <div class="rounded-lg bg-white p-6 shadow-md">
          <div class="mb-3 text-4xl">🧳</div>
          <h2 class="mb-2 text-xl font-semibold text-gray-900">Know what goes in which bag</h2>
          <p class="text-gray-600">
            Carry-on, checked bag, backpack: give each item a bag, and keep small things together in
            containers like a toilet kit.
          </p>
        </div>

        <div class="rounded-lg bg-white p-6 shadow-md">
          <div class="mb-3 text-4xl">📝</div>
          <h2 class="mb-2 text-xl font-semibold text-gray-900">Build your list once</h2>
          <p class="text-gray-600">
            Start from suggestions for beach, business, camping and more. Everything you add is
            saved to My Items for your next trip.
          </p>
        </div>

        <div class="rounded-lg bg-white p-6 shadow-md">
          <div class="mb-3 text-4xl">✅</div>
          <h2 class="mb-2 text-xl font-semibold text-gray-900">Check it off on your phone</h2>
          <p class="text-gray-600">
            Big tap targets and a progress bar while you pack. Plan on your laptop and finish on
            your phone.
          </p>
        </div>
      </div>
    </section>

    <!-- Closing call to action -->
    <section class="container mx-auto px-4 py-12 text-center">
      <h2 class="mb-3 text-3xl font-bold text-gray-900">Ready for your next trip?</h2>
      <p class="mb-6 text-gray-600">
        Free for up to 3 trips. Export a full backup of your data anytime.
      </p>
      <a
        href="/sign-up"
        class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-8 py-3 text-lg font-semibold text-white transition-colors hover:bg-blue-700"
      >
        Get Started Free
      </a>
      <p class="mt-4">
        <a href="/pricing" class="text-blue-600 hover:underline">
          See plans and pricing
        </a>
      </p>
    </section>

    <footer class="border-t border-gray-200 py-6">
      <nav
        aria-label="Footer"
        class="container mx-auto flex flex-wrap justify-center gap-x-6 px-4 text-sm text-gray-600"
      >
        <a href="/pricing" class="flex items-center hover:text-gray-900">
          Pricing
        </a>
        <a href="/sign-in" class="flex items-center hover:text-gray-900">
          Sign in
        </a>
        <a
          href="https://github.com/garyo/packzen"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center hover:text-gray-900"
        >
          Open source on GitHub
        </a>
      </nav>
    </footer>
  </div>
</BaseLayout>
