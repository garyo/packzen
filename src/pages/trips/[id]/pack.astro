---
export const prerender = false;

import AppLayout from '../../../layouts/AppLayout.astro';

const { id } = Astro.params;
---

<AppLayout title="Pack - PackZen" data-trip-id={id} />

<script>
  import { PackingPage } from '../../../components/trips/PackingPage';
  import { mountApp } from '../../../components/nav/mountApp';

  const tripId = document.getElementById('app-root')?.dataset.tripId;
  if (tripId) void mountApp(() => PackingPage({ tripId }));
</script>
