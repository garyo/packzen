---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';

const { id } = Astro.params;
const sortBy = Astro.url.searchParams.get('sortBy') || 'bag';
const columnsParam = Astro.url.searchParams.get('columns');
const includeSkipped = Astro.url.searchParams.get('includeSkipped') === '1';
---

<BaseLayout title="Print Checklist - PackZen">
  <div
    id="app-root"
    data-trip-id={id}
    data-sort-by={sortBy}
    data-columns={columnsParam ?? ''}
    data-include-skipped={includeSkipped ? '1' : '0'}
  >
  </div>
</BaseLayout>

<script>
  import { render } from 'solid-js/web';
  import {
    TripPrintView,
    PRINT_COLUMNS_STORAGE_KEY,
  } from '../../../components/trips/TripPrintView';
  import { mountWhenSignedIn } from '../../../components/trips/auth-gate';

  // Column count: the URL's explicit choice, else the user's last choice, else
  // 2 columns on wide screens and 1 on phones (where 2 won't fit).
  const chooseColumns = (explicit: string | undefined) => {
    const saved = window.localStorage.getItem(PRINT_COLUMNS_STORAGE_KEY);
    for (const value of [explicit, saved]) {
      if (value === '1' || value === '2') return Number(value);
    }
    return window.matchMedia('(max-width: 640px)').matches ? 1 : 2;
  };

  const root = document.getElementById('app-root');
  const tripId = root?.dataset.tripId;
  if (root && tripId) {
    const sortBy = (root.dataset.sortBy as 'bag' | 'category') || 'bag';
    const includeSkipped = root.dataset.includeSkipped === '1';
    const columns = chooseColumns(root.dataset.columns);

    void mountWhenSignedIn(root, () =>
      render(
        () =>
          TripPrintView({
            tripId,
            sortBy,
            initialColumns: columns,
            initialIncludeSkipped: includeSkipped,
          }),
        root
      )
    );
  }
</script>
