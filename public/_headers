# Headers for static assets served by Workers Static Assets. Responses from the
# Worker itself (API routes, server-rendered pages) get the same security
# headers from src/middleware.ts.

/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Astro's build output is content-hashed, so it never changes at a given URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
